# Google Drive (opsional sampai integrasi arsip dipakai).
# Jalur OAuth dipilih karena service account tidak punya kuota penyimpanan
# Drive sendiri, sehingga hanya bekerja pada Shared Drive milik Workspace.
# Scope yang dipakai cukup drive.file: aplikasi hanya menyentuh berkas
# yang dibuatnya sendiri.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
